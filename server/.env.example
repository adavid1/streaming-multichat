# ==== General ====
PORT=8787
# Bind address (use 127.0.0.1 behind a reverse proxy on the same machine)
# HOST=0.0.0.0

# ==== Twitch ====
# Channel name (chat is read anonymously, no token needed)
TWITCH_CHANNEL=yourchannel
# Optional: Twitch API credentials, only used to load the channel's custom
# badges (subscriber, bits). Create an app at https://dev.twitch.tv/console
# The client secret is preferred: the app token is then renewed automatically.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Legacy alternative to TWITCH_CLIENT_SECRET (user token, expires):
# TWITCH_OAUTH=oauth:xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==== YouTube (no API key / no quota) ====
# Channel ID (starts with UC...), see https://www.youtube.com/account_advanced
# The server detects automatically when the channel goes live.
YT_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxx
# How often to check whether the channel is live (seconds)
# YT_POLL_INTERVAL_SECONDS=20

# ==== TikTok ====
# Your TikTok @username (without the @)
TIKTOK_USERNAME=your_tiktok_username
# How often to check whether you are live (seconds, minimum 30)
# TIKTOK_POLL_INTERVAL_SECONDS=30
# Optional Euler Stream API key (https://www.eulerstream.com): raises the
# rate limits of the signing service used to connect to TikTok
# TIKTOK_SIGN_API_KEY=
